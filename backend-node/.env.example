PORT=8000
NODE_ENV=production

# Database Configuration (Aiven MySQL / Cloud Managed MySQL)
DB_HOST=common-feedback-db-abhiramiabhiivk-30b8.k.aivencloud.com
DB_PORT=22692
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=

# SSL / TLS Configuration for Aiven MySQL
# Mode: REQUIRED (enables SSL and certificate verification)
DB_SSL=true
DB_SSL_MODE=REQUIRED
DB_SSL_REJECT_UNAUTHORIZED=true

# Optional: Path to custom CA certificate file (e.g. ./ca.pem) or direct CA cert string
# DB_SSL_CA_PATH=./ca.pem
# DB_SSL_CA=

# JWT and Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
BCRYPT_ROUNDS=12

# Admin Email (users with this email will be granted admin privileges upon login)
ADMIN_EMAIL=admin@gmail.com

# Frontend URL and Allowed Origins for CORS (Production & Development Origins Only)
FRONTEND_URL=https://common-customer-feedback-system.vercel.app
ALLOWED_ORIGINS=https://common-customer-feedback-system.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
