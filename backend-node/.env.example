PORT=8000
NODE_ENV=development

# Database configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=common_feedback_system
DB_USERNAME=root
DB_PASSWORD=

# JWT and Security
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
BCRYPT_ROUNDS=12

# Admin Email (users with this email will be granted admin privileges upon login)
ADMIN_EMAIL=admin@gmail.com

# Frontend URL for CORS and password reset links
FRONTEND_URL=https://common-customer-feedback-system.vercel.app
ALLOWED_ORIGINS=https://common-customer-feedback-system.vercel.app,http://localhost:5173,http://127.0.0.1:5173
